    "query_cf_fail": "2 cf.orig.clean rows per env excluding reference group",
    "visual_probe": [
      "clean",
      "style"
    ],
    "framing_probe": [
      "neu",
      "pos",
      "neg"
    ],
    "row_expansion": "per base query: clean_neu + clean_pos + clean_neg + style_neu"
  },
  "base_prompt": "Below are two storyboard trajectories from the same MiniGrid environment.\n\nReference trajectory:\nThis trajectory is a known successful example of completing the task in this environment.\n\nQuery trajectory:\nDetermine whether this trajectory also completes the same task goal as the reference trajectory.\n\nAnswer with ONLY: Success or Fail.",
  "framing_preambles": {
    "neu": "",
    "pos": "The query trajectory seems to handle the task competently in the following example. ",
    "neg": "The query trajectory seems to struggle with the task in the following example. "
  },
