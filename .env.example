# GridWM-Judge — API Key Configuration
# Copy this file to .env and fill in your actual keys.
# .env is in .gitignore — NEVER commit actual keys.

# ── Zhizengzeng (智增增) ────────────────────────────────────────────────────────
# Primary unified API platform. Supports: gpt-4o, gpt-4o-mini, gpt-3.5-turbo,
# claude-*, gemini-*, grok-*, qwen-vl-*, etc.
# Endpoint: https://api.zhizengzeng.com/v1
ZZZ_API_KEY=sk-your-zzz-key-here

# Legacy alias (some older scripts may reference this)
ZHIZENGZENG_API_KEY=sk-your-zzz-key-here

# ── SiliconFlow (CN-optimized OpenAI-compatible) ──────────────────────────────
# Endpoint: https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=sk-your-sf-key-here

# ── OpenAI (official) ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here

# ── Google Gemini ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-key-here

# ── Zhizengzeng Gemini (via Google-compatible endpoint) ─────────────────────────
# Endpoint: https://api.zhizengzeng.com/google/
ZHIZENGZENG_GEMINI_API_KEY=sk-your-zzz-key-here
